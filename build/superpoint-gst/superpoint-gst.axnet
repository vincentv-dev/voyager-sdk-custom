model=build/superpoint-gst/superpoint-gst/1/model.json
devices=metis-0:1:0
double_buffer=True
dmabuf_inputs=True
dmabuf_outputs=True
num_children=0
preprocess0_lib=libtransform_resize.so
preprocess0_options=width:640;height:480;letterbox:0
preprocess1_lib=libtransform_totensor.so
preprocess1_options=type:int8
