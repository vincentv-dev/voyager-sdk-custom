model=build/squeezenet1.1-imagenet/squeezenet1.1-imagenet/1/model.json
devices=metis-0:1:0
double_buffer=True
dmabuf_inputs=True
dmabuf_outputs=True
num_children=4
preprocess0_lib=libtransform_centrecropextra.so
preprocess0_options=scalesize:256;crop_width:224;crop_height:224
preprocess1_lib=libtransform_resize.so
preprocess1_options=width:224;height:224
preprocess2_lib=libtransform_totensor.so
preprocess2_options=type:int8
preprocess3_lib=libinplace_normalize.so
preprocess3_options=mean:0.485,0.456,0.406;std:0.229,0.224,0.225;simd:neon;quant_scale:0.018718454986810684;quant_zeropoint:-14
preprocess3_mode=write
preprocess4_lib=libtransform_padding.so
preprocess4_options=padding:0,0,0,0,0,0,0,0;fill:-14
preprocess4_batch=1
postprocess0_lib=libtransform_paddingdequantize.so
postprocess0_options=padding:0,0,0,0,0,0,0,-24;dequant_scale:0.15122216939926147;dequant_zeropoint:-129;transpose:0;dequant_lut:1
postprocess1_lib=libdecode_classification.so
postprocess1_options=meta_key:classifications;top_k:5;softmax:0